    {
      "name": "8. Checklist Templates",
      "item": [
        {
          "name": "Create Checklist Template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.isSuccess && res.data) {",
                  "  pm.collectionVariables.set('checklistUuid', res.data.uuid);",
                  "  if (res.data.items && res.data.items.length > 0) {",
                  "    pm.collectionVariables.set('templateItemUuid', res.data.items[0].uuid);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Office Fit-Out Checklist\",\n  \"description\": \"Standard checklist for office fit-out site visits\",\n  \"createdBy\": 1,\n  \"items\": [\n    {\n      \"sectionName\": \"Reception Area\",\n      \"question\": \"Is the reception area layout suitable?\",\n      \"type\": \"YES_NO\",\n      \"isRequired\": true,\n      \"displayOrder\": 0\n    },\n    {\n      \"sectionName\": \"Reception Area\",\n      \"question\": \"Describe the current ceiling condition\",\n      \"type\": \"TEXT\",\n      \"isRequired\": true,\n      \"displayOrder\": 1\n    },\n    {\n      \"sectionName\": \"Workstations\",\n      \"question\": \"Upload photos of work area\",\n      \"type\": \"PHOTO\",\n      \"isRequired\": false,\n      \"displayOrder\": 2\n    },\n    {\n      \"sectionName\": \"Workstations\",\n      \"question\": \"Select flooring type\",\n      \"type\": \"DROPDOWN\",\n      \"isRequired\": true,\n      \"displayOrder\": 3\n    },\n    {\n      \"sectionName\": \"Workstations\",\n      \"question\": \"Power outlets available\",\n      \"type\": \"CHECKBOX\",\n      \"isRequired\": true,\n      \"displayOrder\": 4\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checklist-templates/CreateCheckList",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checklist-templates", "CreateCheckList"]
            }
          }
        },
        {
          "name": "Get All Checklist Templates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/checklist-templates/GetAllCheckList",
