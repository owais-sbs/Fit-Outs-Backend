{
  "info": {
    "name": "Fit-Outs Backend API",
    "_postman_id": "fitouts-backend-api-collection",
    "description": "Complete API collection for the Fit-Outs Backend. Includes Auth, Subscription Plans, Companies, Accounts, Leads, Lead Sources, Lead Status History, Checklist Templates, and Site Visits.\n\n## Flow\n1. Start with Auth > Login → verify-otp → me → sessions\n2. Create Subscription Plan → Create Company (references plan UUID)\n3. Create Account (references company UUID)\n4. Create Lead Source → Create Leads → Update Lead Status\n5. Create Checklist Template → Create Site Visit → Add Location Details → Submit Report",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.isSuccess && res.data && res.data.challengeId) {",
                  "  pm.collectionVariables.set('challengeId', res.data.challengeId);",
                  "  if (res.data.otp) pm.collectionVariables.set('otp', res.data.otp);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.isSuccess) {",
                  "  var cookies = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie');",
                  "  cookies.forEach(c => {",
                  "    if (c.value.startsWith('FITOUTS_SESSION')) {",
                  "      pm.collectionVariables.set('sessionId', c.value.split('=')[1].split(';')[0]);",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Get Current User (/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Get Active Sessions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions"]
            }
          }
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
