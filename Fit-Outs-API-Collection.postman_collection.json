{
  "info": {
    "name": "Fit-Outs Backend API",
    "description": "Complete API collection for Fit-Outs Backend. Base URL: http://localhost:8080\n\nAuth flow: Login → Verify OTP → Use session cookie for authenticated requests.\n\nResponse format:\n- Success: { \"isSuccess\": true, \"data\": ..., \"message\": \"...\" }\n- Failure: { \"isSuccess\": false, \"message\": \"...\", \"error\": \"...\" }",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Cookie",
        "type": "string"
      },
      {
        "key": "value",
        "value": "FITOUTS_SESSION={{sessionCookie}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sessionCookie",
      "value": ""
    },
    {
      "key": "accountUuid",
      "value": ""
    },
    {
      "key": "companyUuid",
      "value": ""
    },
    {
      "key": "subscriptionPlanUuid",
      "value": ""
    },
    {
      "key": "leadId",
      "value": ""
    },
    {
      "key": "leadSourceId",
      "value": ""
    },
    {
      "key": "checklistTemplateUuid",
      "value": ""
    },
    {
      "key": "siteVisitUuid",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.isSuccess && jsonData.data) {",
                  "    if (jsonData.data.challengeId) {",
                  "        pm.collectionVariables.set('challengeId', jsonData.data.challengeId);",
                  "        console.log('OTP required. Challenge ID: ' + jsonData.data.challengeId);",
                  "        if (jsonData.data.otp) console.log('Dev OTP: ' + jsonData.data.otp);",
                  "    }",
                  "    if (jsonData.data.status === 'AUTHENTICATED') {",
                  "        var cookies = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie');",
                  "        cookies.forEach(function(c) {",
                  "            var match = c.value.match(/FITOUTS_SESSION=([^;]+)/);",
                  "            if (match) pm.collectionVariables.set('sessionCookie', match[1]);",
                  "        });",
                  "        console.log('Login successful, session cookie captured.');",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.isSuccess) {",
                  "    var cookies = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie');",
                  "    cookies.forEach(function(c) {",
                  "        var match = c.value.match(/FITOUTS_SESSION=([^;]+)/);",
                  "        if (match) pm.collectionVariables.set('sessionCookie', match[1]);",
                  "    });",
                  "    console.log('OTP verified, session cookie captured.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Get Sessions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions"]
            }
          }
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
